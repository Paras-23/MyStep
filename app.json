{
  "expo": {
    "name": "MyStep",
    "slug": "mystep-ihqbj2",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mystep",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D1117"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.yourname.mystep",
      "infoPlist": {
        "NSMotionUsageDescription": "MyStep uses motion data to count your steps accurately.",
        "NSHealthShareUsageDescription": "MyStep reads your step count from Apple Health.",
        "NSHealthUpdateUsageDescription": "MyStep writes your step data to Apple Health."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundColor": "#0D1117"
      },
      "package": "com.yourname.mystep",
      "permissions": [
        "ACTIVITY_RECOGNITION",
        "BODY_SENSORS",
        "HIGH_SAMPLING_RATE_SENSORS",
        "android.permission.ACTIVITY_RECOGNITION",
        "android.permission.BODY_SENSORS",
        "android.permission.HIGH_SAMPLING_RATE_SENSORS"
      ]
    },
    "plugins": [
      [
        "expo-sensors",
        {
          "motionPermission": "MyStep needs motion access to count your steps."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "79f10512-9e8c-4478-8b19-fa895cadf0eb"
      }
    },
    "owner": "kky18"
  }
}
